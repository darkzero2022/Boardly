# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="file:./kanboard.db"

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# ── Microsoft Azure AD (SSO) ──────────────────────────────────────────────────
# Leave empty to disable Microsoft SSO; only local credentials will be available
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KanBoard <noreply@kanboard.local>"

# ── Browser Push Notifications ────────────────────────────────────────────────
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@kanboard.local"

# ── Microsoft Teams ───────────────────────────────────────────────────────────
# Fallback webhook URL (boards can override in Integrations settings)
TEAMS_WEBHOOK_URL=""

# ── MS Graph API (Planner Two-Way Sync) ───────────────────────────────────────
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_TENANT_ID=""

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

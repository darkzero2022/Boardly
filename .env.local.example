# ══════════════════════════════════════════════════════════════════════════════
#  Boardly — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  Run setup.sh / setup.bat to do this automatically.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — zero config, good for up to ~30 users):
DATABASE_URL="file:./kanboard.db"

# PostgreSQL (recommended for enterprise, 30-500+ users):
# DATABASE_URL="postgresql://kanboard:password@localhost:5432/kanboard"
# Supabase:  DATABASE_URL="postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres"
# Neon:      DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/kanboard?sslmode=require"
# Railway:   (copy from Railway dashboard Variables tab)

# MySQL / MariaDB (if you already run MySQL infrastructure):
# DATABASE_URL="mysql://kanboard:password@localhost:3306/kanboard"

# See docs/database-setup.md for full instructions, connection pooling,
# managed cloud options, and migration from SQLite to PostgreSQL.

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# Or run setup.sh / setup.bat — secret is generated automatically.
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# ── LDAP / Active Directory ───────────────────────────────────────────────────
# Leave LDAP_URI blank to disable LDAP authentication entirely.
# When enabled, a "Directory (LDAP/AD)" tab appears on the login page.
# First-time LDAP logins auto-create the user in the database (role: MEMBER).
#
# Active Directory example:
#   LDAP_URI="ldap://dc.company.com:389"
#   LDAP_BASE_DN="dc=company,dc=com"
#   LDAP_BIND_DN="cn=boardly-svc,ou=Service Accounts,dc=company,dc=com"
#   LDAP_BIND_PASSWORD="service-account-password"
#   LDAP_USER_FILTER="(sAMAccountName={{username}})"
#
# OpenLDAP / FreeIPA example:
#   LDAP_URI="ldap://ldap.company.com:389"
#   LDAP_BASE_DN="dc=company,dc=com"
#   LDAP_BIND_DN="cn=admin,dc=company,dc=com"
#   LDAP_BIND_PASSWORD="admin-password"
#   LDAP_USER_FILTER="(uid={{username}})"
#
# LDAPS (TLS) example:
#   LDAP_URI="ldaps://dc.company.com:636"
#   LDAP_TLS_REJECT_UNAUTHORIZED="true"   # set to "false" for self-signed certs
LDAP_URI=""
LDAP_BASE_DN=""
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
LDAP_USER_FILTER="(|(sAMAccountName={{username}})(uid={{username}})(userPrincipalName={{username}}))"
LDAP_TLS_REJECT_UNAUTHORIZED="true"

# ── Microsoft Azure AD (SSO) ──────────────────────────────────────────────────
# Leave all three blank to disable Microsoft SSO.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Boardly <noreply@boardly.local>"

# ── Browser Push Notifications ────────────────────────────────────────────────
# Leave blank to disable. Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@boardly.local"

# ── Microsoft Teams ───────────────────────────────────────────────────────────
# Fallback webhook URL. Individual boards can override in Integrations settings.
TEAMS_WEBHOOK_URL=""

# ── MS Graph API (Planner Two-Way Sync) ───────────────────────────────────────
# Leave blank to disable Planner sync.
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_TENANT_ID=""

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
